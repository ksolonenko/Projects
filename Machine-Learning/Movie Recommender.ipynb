   "id": "1dbaf28e",
   "metadata": {},
   "outputs": [],
   "source": [
    "#sort movies by popularity (ratings count and average rating)\n",
    "popular_movies = movies_popularity.sort_values(by=['ratings_count', 'average_rating'], ascending=False)\n",
    "\n",
    "def popularity_recommendation(top_n=10):\n",
    "    return popular_movies.head(top_n)\n"
   ]
