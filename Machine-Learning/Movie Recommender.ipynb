   "source": [
    "#average ratings for each movie\n",
    "average_ratings = ratings.groupby('movieId')['rating'].mean()\n",
    "\n",
    "#number of ratings for each movie\n",
    "ratings_count = ratings.groupby('movieId')['rating'].count()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "1822cacb",
   "metadata": {},
   "outputs": [],
   "source": [
    "#merge average ratings and ratings count with the movies df\n",
    "movies_popularity = movies.merge(average_ratings, on='movieId', how='left').merge(ratings_count, on='movieId', how='left')\n",
    "\n",
    "#rename columns\n",
    "movies_popularity.rename(columns={'rating_x': 'average_rating', 'rating_y': 'ratings_count'}, inplace=True)"
   ]
  },
  {
   "cell_type": "code",
